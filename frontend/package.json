{
  "name": "neu-toolbox-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "axios": "^1.6.2",
    "antd": "^5.12.0",
    "@ant-design/icons": "^5.2.6",
    "dayjs": "^1.11.10"
  },
  "scripts": {
    "start": "set NODE_OPTIONS=--openssl-legacy-provider && react-scripts start",
    "start:unix": "NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false --runInBand",
    "test:term-sort": "react-scripts test --watchAll=false --runTestsByPath src/utils/termSort.test.js",
    "test:festival-activities": "react-scripts test --watchAll=false --runTestsByPath src/export/festivalActivityUtils.test.js src/export/festivalDataMode.test.js src/export/exportTools.test.js src/resources/ResourceStore.test.js src/pages/FestivalActivitiesPage.test.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "react-scripts": "^5.0.1"
  },
  "proxy": "http://localhost:8000"
}
