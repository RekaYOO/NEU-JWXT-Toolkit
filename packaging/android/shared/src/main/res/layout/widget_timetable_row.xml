<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="5dp" android:minHeight="32dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_course_time" android:layout_width="35dp" android:layout_height="wrap_content"
        android:layout_marginEnd="6dp" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1"
        android:includeFontPadding="false" android:textSize="10sp" android:textStyle="bold"
        android:textColor="@color/widget_accent" android:background="@drawable/widget_timetable_time" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_course_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
            android:textColor="@color/widget_primary" android:textStyle="bold" android:textSize="12sp" />
        <TextView android:id="@+id/widget_course_place" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
            android:textColor="@color/widget_secondary" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
