<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timetable"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="11dp" android:paddingEnd="11dp" android:paddingTop="9dp" android:paddingBottom="9dp"
    android:background="@drawable/widget_timetable_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
            android:text="@string/widget_timetable_title" android:textStyle="bold" android:textSize="13sp" android:textColor="@color/widget_accent" />
        <TextView android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxLines="1" android:includeFontPadding="false" android:textSize="10sp" android:textColor="@color/widget_secondary" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="2" android:includeFontPadding="false"
        android:text="@string/widget_sync_prompt" android:textSize="12sp" android:textColor="@color/widget_secondary" />
    <LinearLayout android:id="@+id/widget_courses" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:orientation="vertical" />
</LinearLayout>
