<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/widget_timetable" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
    android:paddingTop="3dp" android:paddingBottom="3dp"
    android:background="@drawable/widget_timetable_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_next_title" android:textSize="10sp" android:textStyle="bold"
        android:maxLines="1" android:includeFontPadding="false" android:textColor="@color/widget_accent" />
    <TextView android:id="@+id/widget_next_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="1dp" android:ellipsize="end" android:maxLines="1" android:includeFontPadding="false"
        android:text="@string/widget_sync_prompt" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_primary" />
    <TextView android:id="@+id/widget_next_details" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="1dp" android:ellipsize="end" android:maxLines="1" android:includeFontPadding="false"
        android:textSize="10sp" android:textColor="@color/widget_secondary" android:visibility="gone" />
</LinearLayout>
